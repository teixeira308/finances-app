# Firebase Web SDK Configuration
# All values are provided by the Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=**             # Firebase Web API Key (pública, pode ficar no client)
VITE_FIREBASE_AUTH_DOMAIN=**         # Ex: projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=**          # ID do projeto no Firebase Console
VITE_FIREBASE_STORAGE_BUCKET=**      # Ex: projeto.appspot.com (mesmo se não usar Storage)
VITE_FIREBASE_MESSAGING_SENDER_ID=** # ID numérico do sender para Firebase Cloud Messaging
VITE_FIREBASE_APP_ID=**              # App ID específico do Web App