rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if the user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Rule: Workspaces collection
    match /workspaces/{workspaceId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Rule: Transactions collection
    match /transactions/{transactionId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Rule: Categories collection
    match /categories/{categoryId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Rule: Goals collection
    match /goals/{goalId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Rule: Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rule: Recurring Transactions collection
    match /recurring_transactions/{rtId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Rule: Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}